{
  "name": "pi-web-enhanced",
  "version": "0.35.0",
  "description": "Web search, URL fetching, GitHub repo cloning, and local PDF extraction for Pi coding agent. Supports Exa, Tavily, AnySearch, TinyFish, SerpApi, Firecrawl, Brave, and DuckDuckGo, with weighted-provider balanced search and all-provider enhanced search.",
  "type": "module",
  "scripts": {
    "test": "node --import ./test/isolate-env.mjs --test",
    "typecheck": "tsc",
    "audit:runtime": "npm audit --omit=dev --omit=peer",
    "build": "node scripts/build.js",
    "prepublishOnly": "npm run build && node scripts/pi-extensions-dist.js dist",
    "postpublish": "node scripts/pi-extensions-dist.js index.ts",
    "release": "node scripts/publish.js"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "web-search",
    "exa",
    "tavily",
    "anysearch",
    "tinyfish",
    "serpapi",
    "firecrawl",
    "brave",
    "duckduckgo",
    "fetch",
    "scraping"
  ],
  "author": "Nico Bailon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicobailon/pi-web-access.git"
  },
  "bugs": {
    "url": "https://github.com/nicobailon/pi-web-access/issues"
  },
  "homepage": "https://github.com/nicobailon/pi-web-access#readme",
  "files": [
    "dist",
    "*.ts",
    "CHANGELOG.md",
    "SECURITY.md",
    "banner.png"
  ],
  "devDependencies": {
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@earendil-works/pi-tui": "0.86.1",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.1",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "@mozilla/readability": "^0.6.0",
    "defuddle": "0.19.3",
    "linkedom": "^0.16.0",
    "p-limit": "^6.1.0",
    "promise.try": "^2.0.1",
    "turndown": "^7.2.0",
    "unpdf": "^1.6.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
